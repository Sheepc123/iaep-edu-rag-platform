向量归一化原理
def normalize_vector(vector):
    """向量归一化确保余弦相似度计算正确"""
    norm = np.linalg.norm(vector)
    if norm > 0:
        return vector / norm  # 模长归一化为1
    return vector

# 归一化后的向量特性：
